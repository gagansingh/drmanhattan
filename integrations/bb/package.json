{
  "name": "bb-plugin-drmanhattan",
  "version": "0.9.1",
  "type": "module",
  "description": "Shows each bb thread's drmanhattan runs and tells bb's agents to queue heavy commands through drmanhattan.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gagansingh/drmanhattan.git",
    "directory": "integrations/bb"
  },
  "keywords": [
    "bb-plugin"
  ],
  "engines": {
    "bb": ">=0.49",
    "bbPluginSdk": ">=0.6.132"
  },
  "bb": {
    "name": "drmanhattan",
    "description": "Makes agents in parallel threads take turns on builds and tests, and shows each thread its queued runs.",
    "branding": {
      "icon": "Layers"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bb-app": "0.49.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
